PIPELINE58_HOME=/opt/hanmi-be-risk
PIPELINE58_DATA_HOME=/data/hanmi-be-risk
PIPELINE58_LOG_HOME=/data/hanmi-be-risk/logs

PIPELINE58_PG_HOST=127.0.0.1
PIPELINE58_PG_PORT=5432
